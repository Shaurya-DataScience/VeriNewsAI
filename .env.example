# ==============================================================================
# VeriNews AI - Production Environment Variables Template
# ==============================================================================
# Live Search API (Required for web fact retrieval)
TAVILY_API_KEY=your_tavily_api_key_here

# Hugging Face Access Token (Optional, eliminates rate-limit warnings)
HF_TOKEN=your_optional_hf_token_here

# Allowed CORS Origins (Comma-separated, or * for open access)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourusername.github.io

# Application Server Port (Defaults to 8000)
PORT=8000
